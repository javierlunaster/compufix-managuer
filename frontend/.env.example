# URL base de la API del backend. El valor por defecto en el código ya
# apunta a http://localhost:3000/api si esta variable no está definida,
# así que copiar este archivo es opcional para desarrollo local.
VITE_API_URL=http://localhost:3000/api

# --- Marca (ver src/lib/branding.ts) ----------------------------------
# Ninguna de estas es obligatoria: sin definir, el sitio muestra los
# datos de CompuFix. Para replicar el sitio a un cliente nuevo, definir
# aquí (o como variables de entorno del proyecto en Railway) los datos
# del negocio — el mismo código entonces muestra su marca, sin tocar
# ningún archivo .tsx.
# VITE_BUSINESS_NAME="Nombre completo del negocio"
# VITE_BUSINESS_SHORT_NAME="Nombre corto"
# VITE_BUSINESS_LOCATION="Ciudad, Departamento"
# VITE_BUSINESS_FOOTER_LOCATION="Ciudad, País"
# VITE_BUSINESS_FOOTER_TAGLINE="Lo que hace el negocio, breve"
# VITE_BUSINESS_PHONE_DISPLAY="300 000 0000"
# VITE_BUSINESS_PHONE_DIAL="+57300000000"
# VITE_WHATSAPP_NUMBER="57300000000"
# VITE_WHATSAPP_MESSAGE="Hola, quiero una cotización para mi equipo"
# VITE_BUSINESS_ADDRESS_LINE1="Dirección línea 1"
# VITE_BUSINESS_ADDRESS_LINE2="Dirección línea 2"
# VITE_BUSINESS_ADDRESS_CITY="Ciudad, Departamento"
# VITE_MAPS_URL="https://maps.google.com/..." (opcional — si no se define,
#   se arma una búsqueda a partir de la dirección de arriba)
# Dejar vacía ("") la red que el negocio no tenga — así no se muestra.
# VITE_SOCIAL_FACEBOOK="https://www.facebook.com/..."
# VITE_SOCIAL_INSTAGRAM="https://www.instagram.com/..."
# VITE_SOCIAL_YOUTUBE="https://www.youtube.com/..."
# Logo: ruta local (si se reemplaza public/logo.png en este mismo
# despliegue) o URL externa (ej. alojado en el Supabase Storage propio
# del cliente) — así no hace falta tocar el repositorio para cambiarlo.
# VITE_LOGO_URL="https://.../logo.png"
