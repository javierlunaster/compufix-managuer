# Copiar como .env.prod y completar con valores reales antes de desplegar.
# NUNCA subir el .env.prod real a un repositorio de git.

DB_USER=compufix
DB_PASSWORD=cambiar-por-una-contraseña-larga-y-aleatoria
DB_NAME=compufix

# Generar con: openssl rand -base64 48   (o cualquier generador de secretos)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Generar con: openssl rand -base64 32
# ¡OJO! Si estás migrando datos de un entorno anterior (pruebas → producción),
# esta llave debe ser EXACTAMENTE la misma que ya usabas — cambiarla vuelve
# indescifrables las contraseñas de equipos y licencias ya guardadas.
ENCRYPTION_KEY=

# Dominio real, sin "https://" ni barra final (Caddy lo usa tal cual para
# pedir el certificado TLS). Ej: taller.midominio.com
DOMAIN=

# Correo para los avisos de Let's Encrypt (vencimiento, problemas de
# renovación) — no es un correo del sistema, es solo para Caddy/Let's Encrypt.
ADMIN_EMAIL=

# Dominio real del frontend en producción, CON "https://" (a diferencia de
# DOMAIN arriba). Debe coincidir: si DOMAIN=taller.midominio.com, esto es
# https://taller.midominio.com — el backend lo usa para restringir CORS.
FRONTEND_URL=

# URL que el frontend usará para hablarle a la API. Con Caddy enrutando
# /api al backend bajo el mismo dominio (como ya está configurado en
# deploy/caddy/Caddyfile), el valor por defecto "/api" es correcto y no
# hay que tocarlo.
VITE_API_URL=/api
