# Copiar como .env y ajustar si es necesario.
# Debe coincidir con las credenciales de docker-compose.yml

DATABASE_URL="postgresql://compufix:compufix_local@localhost:5432/compufix?schema=public"

# Clave para cifrar campos sensibles (contraseñas de equipos, licencias de
# software). Generar una propia de 32 bytes en producción, nunca reusar esta.
ENCRYPTION_KEY="reemplazar-por-una-llave-segura-de-32-bytes"

# Se usará a partir de la Fase 2 (autenticación)
JWT_SECRET="UOqSnakiApuPNjv+5V11H20a9H1DhUaglrYZyEXwRVYCR96pY6YGUWZLjc98s+LO"
JWT_EXPIRES_IN="8h"

PORT=3000

# Restringe CORS a este origen en producción (separar varios con comas).
# En desarrollo local, si se deja vacío, se permite cualquier origen.
FRONTEND_URL=http://localhost:5173

# development | production — controla el detalle de errores expuestos
# (ver AllExceptionsFilter) y bloquea secretos de ejemplo sin cambiar.
NODE_ENV=development
