# Copiar como .env y completar con los valores reales de tu proyecto de
# Supabase (Project Settings → Database, y Project Settings → API).

# Cadena de conexión a Postgres de Supabase. Usa la "Connection string" en
# modo "Session" (puerto 5432) — Prisma necesita una conexión persistente
# normal, no el pooler en modo "Transaction" (puerto 6543), que no soporta
# prepared statements. Se ve así:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/compufix?schema=public"

# Clave para cifrar campos sensibles (contraseñas de equipos, licencias de
# software). Generar una propia de 32 bytes en producción, nunca reusar esta.
ENCRYPTION_KEY="reemplazar-por-una-llave-segura-de-32-bytes"

JWT_SECRET="reemplazar-por-un-secreto-seguro"
JWT_EXPIRES_IN="8h"

PORT=3000

# --- Supabase Storage (fotos de evidencia, Fase 15) ------------------------
# Project Settings → API → Project URL
SUPABASE_URL="https://tu-proyecto.supabase.co"
# Project Settings → API → Project API keys → service_role (secreta, NUNCA
# la anon key ni exponerla al frontend — el backend la usa para subir/borrar
# archivos en nombre de cualquier usuario ya autenticado por JwtAuthGuard).
SUPABASE_SERVICE_ROLE_KEY="reemplazar-por-la-service-role-key"
# Bucket creado en Storage → New bucket, marcado como "Public" (las fotos
# de evidencia no son datos sensibles en sí — lo sensible, como la
# contraseña del equipo, va cifrado aparte en la base de datos, nunca en
# un archivo). Si usas otro nombre de bucket, cámbialo aquí.
SUPABASE_STORAGE_BUCKET="attachments"

# Restringe CORS a este origen en producción (separar varios con comas).
# En desarrollo local, si se deja vacío, se permite cualquier origen.
# También se usa para armar el enlace al portal del cliente en los
# correos de notificación (ver mail/mail.service.ts).
FRONTEND_URL=http://localhost:5173

# --- Correo (ver src/mail/) ---------------------------------------------
# Notificaciones automáticas al cliente por correo: ingreso de equipo,
# cotización enviada, equipo listo para entrega. Si se deja vacío, el
# sistema sigue funcionando normal — simplemente no se envían correos (se
# registra un aviso al arrancar).
# Crea una cuenta gratuita en https://resend.com y genera una API key.
RESEND_API_KEY=""
# Remitente que ve el cliente. Con el dominio de prueba de Resend
# (onboarding@resend.dev) solo llegan correos a tu propia cuenta de
# Resend — para enviar a clientes reales hay que verificar tu dominio en
# Resend (Domains → Add Domain) y usar una dirección de ese dominio aquí.
MAIL_FROM="CompuFix Soluciones Integrales <onboarding@resend.dev>"

# development | production — controla el detalle de errores expuestos
# (ver AllExceptionsFilter) y bloquea secretos de ejemplo sin cambiar.
NODE_ENV=development

# --- Marca (ver src/common/config/branding.config.ts) -----------------
# Nombre del negocio en los documentos PDF generados (informe técnico,
# comprobantes, certificados, cotizaciones) y en el log de arranque.
# Sin definir, se usan los datos de CompuFix. Para replicar el backend a
# un cliente nuevo, basta con definir esto en su propio proyecto.
# BUSINESS_NAME="Nombre completo del negocio"
# BUSINESS_TAGLINE="Taller de reparación de computadores"
