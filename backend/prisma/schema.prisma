// =============================================================================
// COMPufix Manager — Modelo de datos (Fase 1)
// Basado en el análisis de Inventario-PC.xlsx (ver documento de arquitectura)
// =============================================================================
// Convenciones:
//  - Ningún borrado físico de registros de negocio: se usa el campo `status`
//    (ACTIVE/INACTIVE) en vez de DELETE (Regla 1 del brief).
//  - El inventario nunca se modifica directo: todo pasa por InventoryMovement
//    (Regla 2 del brief). `Product.stock` es un caché, no la fuente de verdad.
//  - Los saldos (balance, ganancia) NO se almacenan como campos editables;
//    se calculan en la capa de aplicación a partir de los montos base.
//  - Todas las fechas se guardan como DateTime real, nunca como
//    Año/Mes/Día en columnas separadas (patrón detectado en el Excel).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. SEGURIDAD: usuarios, roles, permisos
// -----------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // Administrador, Gerente, Técnico, Recepción, Inventario, Ventas
  description String?
  status      RecordStatus     @default(ACTIVE)
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique // ej. "repair_orders.delete", "inventory.adjust"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// El brief unifica "usuarios" y "técnicos" (sección 21): todo el personal que
// usa el sistema es un User; los que reparan equipos además tienen datos de
// productividad/especialidad.
model User {
  id             Int          @id @default(autoincrement())
  fullName       String
  documentId     String?      @unique
  email          String?      @unique
  phone          String?
  username       String       @unique
  passwordHash   String
  roleId         Int
  role           Role         @relation(fields: [roleId], references: [id])
  specialty      String? // solo aplica a técnicos, texto libre por ahora
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  // relaciones donde este usuario participa
  assignedOrders      RepairOrder[]        @relation("AssignedTechnician")
  statusChanges        RepairStatusHistory[]
  diagnosticsPerformed RepairDiagnostic[]
  logEntries           RepairLog[]
  serviceJobs          ServiceJob[]         @relation("TechnicianOnJob")
  sales                Sale[]
  payments             Payment[]
  inventoryMovements   InventoryMovement[]
  cashRegistersOpened  CashRegister[]       @relation("OpenedBy")
  cashRegistersClosed  CashRegister[]       @relation("ClosedBy")
  cashMovements        CashMovement[]
  auditLogs            AuditLog[]
  attachmentsUploaded  Attachment[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// 2. CLIENTES Y PROVEEDORES
// -----------------------------------------------------------------------------

enum CustomerType {
  PERSON
  COMPANY
}

model Customer {
  id           Int          @id @default(autoincrement())
  fullName     String
  // normalizedName se usa en la migración para detectar/fusionar duplicados
  // (minúsculas, sin tildes, sin espacios extra) — ver plan de migración.
  normalizedName String
  customerType CustomerType @default(PERSON)
  documentId   String? // cédula/NIT — el Excel nunca lo capturaba; queda opcional pero se recomienda exigirlo hacia adelante
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  notes        String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  repairOrders   RepairOrder[]       @relation("CustomerOrders")
  devices        Device[]            @relation("CustomerDevices")
  quotations   CustomerQuotation[]
  sales        Sale[]
  payments     Payment[]
  serviceJobs  ServiceJob[]
  warrantyClaims Warranty[] @relation("ClaimingCustomer")
  softwareLicenses SoftwareLicense[]

  @@index([normalizedName])
  @@map("customers")
}

model Supplier {
  id             Int          @id @default(autoincrement())
  name           String
  contactName    String?
  documentId     String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  paymentAccount String? // referencia rápida; el detalle vive en PaymentAccount
  notes          String?
  status         RecordStatus @default(ACTIVE)

  productRefs    ProductSupplierRef[]
  purchases      Purchase[]
  priceRequestQuotes SupplierPriceRequestQuote[]
  paymentAccounts PaymentAccount[]

  @@map("suppliers")
}

model PaymentAccount {
  id         Int          @id @default(autoincrement())
  supplierId Int?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id])
  ownerName  String // ej. "Jawan", "Virtual Tronic" — de la hoja Transferencias
  channel    String // Nequi, Bancolombia, etc.
  accountRef String? // número de cuenta o de celular
  status     RecordStatus @default(ACTIVE)

  @@map("payment_accounts")
}

// -----------------------------------------------------------------------------
// 3. CATÁLOGOS DE EQUIPO
// -----------------------------------------------------------------------------

model DeviceType {
  id     Int          @id @default(autoincrement())
  name   String       @unique // Portátil, Torre, All in One, Tablet, Placa base, Impresora...
  status RecordStatus @default(ACTIVE)

  devices Device[]

  @@map("device_types")
}

model Brand {
  id     Int          @id @default(autoincrement())
  name   String       @unique
  status RecordStatus @default(ACTIVE)

  devices  Device[]
  products Product[]

  @@map("brands")
}

// -----------------------------------------------------------------------------
// 4. INVENTARIO Y PRODUCTOS
// -----------------------------------------------------------------------------

model ProductCategory {
  id     Int          @id @default(autoincrement())
  name   String       @unique // Cargadores, Baterías, Pantallas, SSD, RAM, MOSFET, Licencias, etc.
  status RecordStatus @default(ACTIVE)

  products Product[]

  @@map("product_categories")
}

model Product {
  id            Int             @id @default(autoincrement())
  sku           String          @unique
  internalCode  String? // "Referencia Jawan" en el Excel — código propio del taller
  categoryId    Int
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  brandId       Int?
  brand         Brand?          @relation(fields: [brandId], references: [id])
  description   String
  cost          Decimal         @default(0) @db.Decimal(12, 2)
  salePrice     Decimal         @default(0) @db.Decimal(12, 2)
  stock         Int             @default(0) // caché — la fuente de verdad son los InventoryMovement
  minStock      Int             @default(0)
  location      String?
  warrantyMonths Int?
  status        RecordStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())

  supplierRefs       ProductSupplierRef[]
  movements          InventoryMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  repairParts        RepairPart[]
  quotationItems     QuotationItem[]
  softwareLicenses   SoftwareLicense[]

  @@map("products")
}

// N:N producto-proveedor: en el Excel "Referencia Jawan" y "Referencia Virtual
// Tronic" eran columnas fijas de un mismo producto — se modela como tabla
// relacional para admitir cualquier número de proveedores sin tocar el esquema.
model ProductSupplierRef {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  supplierId  Int
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  supplierRef String // referencia/código que usa ESE proveedor para el producto
  lastCost    Decimal? @db.Decimal(12, 2)

  @@unique([productId, supplierId])
  @@map("product_supplier_refs")
}

// Caso especial detectado en INVENTARIO: licencias de Windows/Office vendidas
// con credenciales — nunca en texto plano (sección 32 del brief).
model SoftwareLicense {
  id                Int          @id @default(autoincrement())
  productId         Int?
  product           Product?     @relation(fields: [productId], references: [id])
  customerId        Int?
  customer          Customer?    @relation(fields: [customerId], references: [id])
  deviceName        String?
  accountEmail      String?
  passwordEncrypted String? // cifrado a nivel de aplicación (AES) — nunca texto plano
  installedAt       DateTime?
  expiresAt         DateTime?
  status            RecordStatus @default(ACTIVE)

  @@map("software_licenses")
}

enum InventoryMovementType {
  PURCHASE
  SALE
  USED_IN_REPAIR
  ADJUSTMENT
  RETURN
  TRANSFER
  LOSS
  WARRANTY_REPLACEMENT
}

model InventoryMovement {
  id            Int                    @id @default(autoincrement())
  productId     Int
  product       Product                @relation(fields: [productId], references: [id])
  type          InventoryMovementType
  quantity      Int // positivo = entra, negativo = sale
  unitCost      Decimal?               @db.Decimal(12, 2)
  repairOrderId Int?
  repairOrder   RepairOrder?           @relation(fields: [repairOrderId], references: [id])
  purchaseId    Int?
  purchase      Purchase?              @relation(fields: [purchaseId], references: [id])
  saleId        Int?
  sale          Sale?                  @relation(fields: [saleId], references: [id])
  userId        Int
  user          User                   @relation(fields: [userId], references: [id])
  notes         String?
  createdAt     DateTime               @default(now())

  @@map("inventory_movements")
}

// -----------------------------------------------------------------------------
// 5. COMPRAS Y COTIZACIONES DE COMPRA A PROVEEDOR
// -----------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  NEQUI
  BANCOLOMBIA
  TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model Purchase {
  id            Int             @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  date          DateTime
  invoiceNumber String?
  subtotal      Decimal         @db.Decimal(12, 2)
  tax           Decimal         @default(0) @db.Decimal(12, 2)
  shipping      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus   @default(PENDING)
  notes         String?
  status        RecordStatus    @default(ACTIVE)

  items     PurchaseItem[]
  movements InventoryMovement[]

  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@map("purchase_items")
}

// Mapea la hoja "Cotizaciones" del Excel — confirmado que son cotizaciones de
// COMPRA (comparación de precio entre proveedores), no cotizaciones a cliente.
enum PriceRequestStatus {
  REQUESTED
  QUOTED
  PURCHASED
  EXPIRED
}

model SupplierPriceRequest {
  id               Int                          @id @default(autoincrement())
  date             DateTime
  productDescription String
  quantityNeeded   Int                          @default(1)
  chosenSupplierId Int?
  finalPrice       Decimal?                     @db.Decimal(12, 2)
  shippingCost     Decimal?                     @db.Decimal(12, 2)
  profit           Decimal?                     @db.Decimal(12, 2)
  trackingGuide    String?
  status           PriceRequestStatus           @default(REQUESTED)
  notes            String?

  quotes SupplierPriceRequestQuote[]

  @@map("supplier_price_requests")
}

// Un renglón por proveedor cotizante (antes eran columnas fijas: "Virtual
// Tronic", "Jawam", "Digital", "Otro" — ahora es una tabla N:1 sin límite).
model SupplierPriceRequestQuote {
  id              Int                    @id @default(autoincrement())
  priceRequestId  Int
  priceRequest    SupplierPriceRequest   @relation(fields: [priceRequestId], references: [id])
  supplierId      Int
  supplier        Supplier               @relation(fields: [supplierId], references: [id])
  quotedPrice     Decimal                @db.Decimal(12, 2)

  @@unique([priceRequestId, supplierId])
  @@map("supplier_price_request_quotes")
}

// -----------------------------------------------------------------------------
// 6. VENTAS (POS de repuestos y accesorios)
// -----------------------------------------------------------------------------

model Sale {
  id            Int            @id @default(autoincrement())
  customerId    Int?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  sellerId      Int
  seller        User           @relation(fields: [sellerId], references: [id])
  date          DateTime       @default(now())
  invoiceNumber String?
  subtotal      Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        RecordStatus   @default(ACTIVE)

  items     SaleItem[]
  movements InventoryMovement[]
  payments  Payment[]

  @@map("sales")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@map("sale_items")
}

// -----------------------------------------------------------------------------
// 7. SERVICIOS (catálogo) Y SERVICIOS B2B CON COMISIÓN
// -----------------------------------------------------------------------------

model Service {
  id                Int          @id @default(autoincrement())
  code              String?      @unique // de "Codigos de facturacion"
  name              String
  description       String?
  basePrice         Decimal      @db.Decimal(12, 2)
  estimatedCost     Decimal?     @db.Decimal(12, 2)
  warrantyMonths    Int?
  estimatedTimeHours Decimal?    @db.Decimal(6, 2)
  status            RecordStatus @default(ACTIVE)

  repairServices RepairService[]
  quotationItems QuotationItem[]

  @@map("services")
}

// Mapea la hoja "Servicios": trabajos B2B con comisión de técnico. Distinto
// del flujo normal de reparación porque paga comisión, no usa repair_orders.
model ServiceJob {
  id                     Int          @id @default(autoincrement())
  date                   DateTime
  customerId             Int
  customer               Customer     @relation(fields: [customerId], references: [id])
  description            String
  technicianId           Int
  technician             User         @relation("TechnicianOnJob", fields: [technicianId], references: [id])
  chargedAmount          Decimal      @db.Decimal(12, 2)
  // Confirmado: el % de comisión se ajusta manualmente por servicio, no es
  // una regla fija del negocio — por eso se captura el monto, no un %.
  retentionAmount        Decimal      @db.Decimal(12, 2)
  amountToPayTechnician  Decimal      @db.Decimal(12, 2)
  paymentStatus          PaymentStatus @default(PENDING)
  notes                  String?

  @@map("service_jobs")
}

// -----------------------------------------------------------------------------
// 8. ÓRDENES DE REPARACIÓN (entidad central del sistema)
// -----------------------------------------------------------------------------

enum RepairStatus {
  RECEIVED // Ingresado
  DIAGNOSING // En diagnóstico
  QUOTING // Cotizando
  AWAITING_APPROVAL // Esperando aprobación
  APPROVED // Aprobado
  IN_REPAIR // En reparación
  AWAITING_PART // Esperando repuesto
  TESTING // En pruebas
  REPAIRED // Reparado
  READY_FOR_PICKUP // Listo para entrega
  DELIVERED // Entregado
  NOT_REPAIRED // No reparado
  CANCELLED // Cancelado
  WARRANTY // En garantía
}

model RepairOrder {
  id           Int          @id @default(autoincrement())
  // Código visible al cliente, ej. "C11061" — generado como 'C' + id para
  // mantener compatibilidad con el formato ya usado en Bitacora de
  // reparaciones y Datos de Operacion (confirmado por cruce de datos).
  orderCode    String       @unique
  customerId   Int
  customer     Customer     @relation("CustomerOrders", fields: [customerId], references: [id])
  technicianId Int?
  technician   User?        @relation("AssignedTechnician", fields: [technicianId], references: [id])

  // El equipo es una entidad propia (ver Device más abajo) para poder
  // relacionar todo el historial de un mismo equipo físico entre varias
  // visitas (Regla 6 del brief). Los datos que describen AL EQUIPO viven en
  // Device; aquí solo queda lo que describe ESTE ingreso puntual.
  deviceId     Int
  device       Device       @relation(fields: [deviceId], references: [id])

  chargerReceived  Boolean @default(false)
  batteryReceived  Boolean @default(false)
  keyboardReceived Boolean @default(false)
  mouseReceived    Boolean @default(false)
  physicalCondition String?
  accessoriesNotes  String?

  // Contraseña de acceso al equipo proporcionada por el cliente en ESTE
  // ingreso — cifrada, acceso restringido, con posibilidad de purgarla tras
  // la entrega (requisito explícito de seguridad, sección 32 del brief).
  // Vive en la orden y no en Device porque puede cambiar entre visitas y no
  // debe conservarse indefinidamente una vez entregado el equipo.
  devicePasswordEncrypted String?

  entryReason    String?
  reportedIssue  String
  status         RepairStatus @default(RECEIVED)

  totalValue  Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal  @default(0) @db.Decimal(12, 2)
  // balance y ganancia NO se guardan: se calculan en la capa de aplicación.

  entryDate    DateTime  @default(now())
  deliveryDate DateTime?
  notes        String?
  recordStatus RecordStatus @default(ACTIVE)

  statusHistory     RepairStatusHistory[]
  diagnostics       RepairDiagnostic[]
  logs              RepairLog[]
  partsUsed         RepairPart[]
  servicesUsed      RepairService[]
  procedures        RepairProcedure[]
  photos            Attachment[]        @relation("RepairOrderAttachments")
  quotations        CustomerQuotation[] @relation("QuotationSourceOrder")
  payments          Payment[]
  warranties        Warranty[]          @relation("OriginRepairOrder")
  inventoryMovements InventoryMovement[]

  @@map("repair_orders")
}

// Equipo físico del cliente, independiente de cada visita al taller.
// Permite responder "¿este portátil ya había estado aquí?" cruzando por
// número de serie, y ver el historial completo de reparaciones de un mismo
// equipo (Regla 6), no solo de un cliente (Regla 5).
model Device {
  id           Int         @id @default(autoincrement())
  customerId   Int
  customer     Customer    @relation("CustomerDevices", fields: [customerId], references: [id])

  deviceTypeId Int
  deviceType   DeviceType  @relation(fields: [deviceTypeId], references: [id])
  brandId      Int?
  brand        Brand?      @relation(fields: [brandId], references: [id])
  model        String?
  serialNumber String?
  boardModel   String?
  cpu          String?
  ram          String?
  disk         String?
  operatingSystem String?
  notes        String?

  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  repairOrders RepairOrder[]

  // Un mismo número de serie no debería repetirse para EL MISMO cliente
  // (podría repetirse entre clientes distintos por error de fábrica o
  // equipos clonados, así que no se hace único a nivel global).
  @@unique([customerId, serialNumber])
  @@index([serialNumber])
  @@map("devices")
}

// Reemplaza las 4 columnas fijas "Procedimiento 1..4" del Excel por una
// lista de longitud variable.
model RepairProcedure {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  description   String
  performedAt   DateTime    @default(now())

  @@map("repair_procedures")
}

model RepairStatusHistory {
  id            Int          @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder  @relation(fields: [repairOrderId], references: [id])
  previousStatus RepairStatus?
  newStatus     RepairStatus
  changedAt     DateTime     @default(now())
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  notes         String?

  @@map("repair_status_history")
}

// -----------------------------------------------------------------------------
// 9. DIAGNÓSTICO ELECTRÓNICO (basado en la hoja "Datos de Operacion")
// -----------------------------------------------------------------------------

model RepairDiagnostic {
  id              Int          @id @default(autoincrement())
  repairOrderId   Int
  repairOrder     RepairOrder  @relation(fields: [repairOrderId], references: [id])
  technicianId    Int?
  technician      User?        @relation(fields: [technicianId], references: [id])

  boardReference  String? // ej. "6050A3356201"
  chargerIc       String? // ej. "BQ25A"
  initialSymptom  String?
  componentSuspected String?
  componentReplaced  String?
  biosReprogrammed   Boolean @default(false)
  ecReviewed         Boolean @default(false)
  ecReprogrammed     Boolean @default(false)
  proceduresPerformed String?
  result             String?
  createdAt          DateTime @default(now())

  measurements DiagnosticMeasurement[]
  // Fotos que evidencian el trabajo realizado y el estado final del
  // equipo (a diferencia de las fotos de bitácora, estas SÍ se muestran
  // en el portal del cliente — ver customer-portal.service.ts).
  photos Attachment[] @relation("DiagnosticAttachments")

  @@map("repair_diagnostics")
}

// Tabla libre de mediciones en vez de una columna fija por señal (ACDET,
// ACOK, PLTRST, RSMRST...) — permite agregar cualquier punto de cualquier
// placa sin tocar el esquema, tal como pide la sección 8 del brief.
model DiagnosticMeasurement {
  id             Int               @id @default(autoincrement())
  diagnosticId   Int
  diagnostic     RepairDiagnostic  @relation(fields: [diagnosticId], references: [id])
  pointName      String // ej. "ACDET", "PL612", "Consumo S0"
  expectedValue  String?
  measuredValue  String?
  unit           String? // V, A, Ω, Estado...
  status         String? // OK, FUERA DE RANGO, N/A...

  @@map("diagnostic_measurements")
}

// -----------------------------------------------------------------------------
// 10. BITÁCORA DE REPARACIÓN
// -----------------------------------------------------------------------------

model RepairLog {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  technicianId  Int
  technician    User        @relation(fields: [technicianId], references: [id])
  date          DateTime    @default(now())
  procedure     String?
  measurement   String?
  component     String?
  reference     String?
  result        String?
  notes         String?

  photos Attachment[] @relation("RepairLogAttachments")

  @@map("repair_logs")
}

// -----------------------------------------------------------------------------
// 11. REPUESTOS Y SERVICIOS UTILIZADOS EN UNA REPARACIÓN
// -----------------------------------------------------------------------------

model RepairPart {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int         @default(1)
  unitCost      Decimal     @db.Decimal(12, 2) // costo al momento de usarlo
  unitPrice     Decimal     @db.Decimal(12, 2) // precio cobrado al cliente

  @@map("repair_parts")
}

model RepairService {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  serviceId     Int
  service       Service     @relation(fields: [serviceId], references: [id])
  price         Decimal     @db.Decimal(12, 2)

  @@map("repair_services")
}

// -----------------------------------------------------------------------------
// 12. COTIZACIONES A CLIENTE (entidad nueva, sin histórico en el Excel)
// -----------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  SENT
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

model CustomerQuotation {
  id             Int              @id @default(autoincrement())
  quotationNumber String          @unique
  customerId     Int
  customer       Customer         @relation(fields: [customerId], references: [id])
  sourceOrderId  Int? // si nace de una orden de reparación en diagnóstico
  sourceOrder    RepairOrder?     @relation("QuotationSourceOrder", fields: [sourceOrderId], references: [id])
  date           DateTime         @default(now())
  status         QuotationStatus  @default(DRAFT)
  subtotal       Decimal          @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  tax            Decimal          @default(0) @db.Decimal(12, 2)
  shipping       Decimal          @default(0) @db.Decimal(12, 2)
  total          Decimal          @db.Decimal(12, 2)
  validUntil     DateTime?
  notes          String?

  items QuotationItem[]

  @@map("customer_quotations")
}

enum QuotationItemType {
  PART
  SERVICE
  LABOR
  OTHER
}

model QuotationItem {
  id          Int               @id @default(autoincrement())
  quotationId Int
  quotation   CustomerQuotation @relation(fields: [quotationId], references: [id])
  type        QuotationItemType
  productId   Int?
  product     Product?          @relation(fields: [productId], references: [id])
  serviceId   Int?
  service     Service?          @relation(fields: [serviceId], references: [id])
  description String
  quantity    Int               @default(1)
  unitPrice   Decimal           @db.Decimal(12, 2)
  subtotal    Decimal           @db.Decimal(12, 2)

  @@map("quotation_items")
}

// -----------------------------------------------------------------------------
// 13. PAGOS
// -----------------------------------------------------------------------------

model Payment {
  id            Int           @id @default(autoincrement())
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id])
  repairOrderId Int?
  repairOrder   RepairOrder?  @relation(fields: [repairOrderId], references: [id])
  saleId        Int?
  sale          Sale?         @relation(fields: [saleId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  date          DateTime      @default(now())
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  notes         String?

  cashMovements CashMovement[]

  @@map("payments")
}

// -----------------------------------------------------------------------------
// 14. GARANTÍAS
// -----------------------------------------------------------------------------

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
}

model Warranty {
  id                  Int            @id @default(autoincrement())
  repairOrderId       Int
  repairOrder         RepairOrder    @relation("OriginRepairOrder", fields: [repairOrderId], references: [id])
  deliveryDate        DateTime
  warrantyStartDate   DateTime
  warrantyEndDate     DateTime
  coverageDescription String
  status              WarrantyStatus @default(ACTIVE)
  // si el cliente vuelve por garantía, se relaciona con la orden original
  claimingCustomerId  Int?
  claimingCustomer    Customer?      @relation("ClaimingCustomer", fields: [claimingCustomerId], references: [id])
  claimNotes          String?

  @@map("warranties")
}

// -----------------------------------------------------------------------------
// 15. CAJA
// -----------------------------------------------------------------------------

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id             Int                 @id @default(autoincrement())
  openedAt       DateTime            @default(now())
  closedAt       DateTime?
  openedById     Int
  openedBy       User                @relation("OpenedBy", fields: [openedById], references: [id])
  closedById     Int?
  closedBy       User?               @relation("ClosedBy", fields: [closedById], references: [id])
  openingAmount  Decimal             @db.Decimal(12, 2)
  closingAmount  Decimal?            @db.Decimal(12, 2)
  expectedAmount Decimal?            @db.Decimal(12, 2)
  difference     Decimal?            @db.Decimal(12, 2)
  status         CashRegisterStatus  @default(OPEN)

  movements CashMovement[]

  @@map("cash_registers")
}

enum CashMovementType {
  INCOME
  EXPENSE
}

model CashMovement {
  id             Int              @id @default(autoincrement())
  cashRegisterId Int
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  category       String // Reparaciones, Ventas, Servicios, Abonos, Compras, Gastos, Envios, Otros...
  amount         Decimal          @db.Decimal(12, 2)
  paymentId      Int?
  payment        Payment?         @relation(fields: [paymentId], references: [id])
  description    String?
  date           DateTime         @default(now())
  userId         Int
  user           User             @relation(fields: [userId], references: [id])

  @@map("cash_movements")
}

// -----------------------------------------------------------------------------
// 16. GASTOS E IMPUESTOS
// -----------------------------------------------------------------------------

model Expense {
  id            Int           @id @default(autoincrement())
  date          DateTime
  category      String
  description   String?
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  status        RecordStatus  @default(ACTIVE)

  @@map("expenses")
}

model TaxInvoice {
  id       Int           @id @default(autoincrement())
  date     DateTime
  invoiceNumber String
  amount   Decimal       @db.Decimal(12, 2)
  status   PaymentStatus @default(PENDING)

  @@map("tax_invoices")
}

// -----------------------------------------------------------------------------
// 17. ADJUNTOS (fotos, documentos) — polimórfico simple
// -----------------------------------------------------------------------------

model Attachment {
  id            Int      @id @default(autoincrement())
  repairOrderId Int?
  repairOrder   RepairOrder? @relation("RepairOrderAttachments", fields: [repairOrderId], references: [id])
  // Opcional: si la foto documenta un paso puntual de la bitácora (no solo
  // el estado general del equipo), queda enlazada también a esa entrada
  // específica. Cuando se sube desde una entrada de bitácora, se guarda
  // AMBOS ids (repairOrderId y repairLogId) para que la foto también
  // aparezca en la galería general de la orden, no solo dentro del log.
  repairLogId   Int?
  repairLog     RepairLog?   @relation("RepairLogAttachments", fields: [repairLogId], references: [id])
  // Fotos de un diagnóstico puntual — evidencia del trabajo realizado y el
  // estado final, pensadas para reportarse al cliente (a diferencia de las
  // de bitácora, que son notas técnicas internas). Se guarda también
  // repairOrderId (igual que con repairLogId) para que la foto siga
  // contando como "de esta orden" en cualquier consulta general.
  diagnosticId  Int?
  diagnostic    RepairDiagnostic? @relation("DiagnosticAttachments", fields: [diagnosticId], references: [id])
  fileUrl       String
  fileType      String // image/jpeg, application/pdf...
  category      String? // equipo_recibido, daño_fisico, placa, serial, diagnostico, resultado_final...
  description   String?
  uploadedById  Int
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime @default(now())

  @@map("attachments")
}

// -----------------------------------------------------------------------------
// 18. TRAZABILIDAD
// -----------------------------------------------------------------------------

model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  action        String // CREATE, UPDATE, DELETE(lógico), STATUS_CHANGE, PRICE_CHANGE...
  entityType    String // "RepairOrder", "Product", "Payment"...
  entityId      Int
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}
